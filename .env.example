# =============================================================================
# Developer Automation Agent — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to VCS.
# =============================================================================

# ---------- IronClaw Runtime -------------------------------------------------
IRONCLAW_URL=http://localhost:9090       # URL of the local IronClaw (Rust OpenClaw) runtime
IRONCLAW_API_KEY=                        # Optional API key for IronClaw authentication
IRONCLAW_TIMEOUT=120                     # Request timeout in seconds

# ---------- Slack ------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=

# ---------- GitHub -----------------------------------------------------------
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=

# ---------- Jira -------------------------------------------------------------
JIRA_URL=https://your-org.atlassian.net
JIRA_USER=you@example.com
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=

# ---------- Confluence -------------------------------------------------------
CONFLUENCE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_USER=you@example.com
CONFLUENCE_API_TOKEN=

# ---------- Jenkins ----------------------------------------------------------
JENKINS_URL=https://jenkins.example.com
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_WEBHOOK_SECRET=

# ---------- Gmail ------------------------------------------------------------
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# ---------- Server -----------------------------------------------------------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# ---------- Database (PostgreSQL) --------------------------------------------
DATABASE_URL=postgresql://claw:claw@localhost:5432/clawagent
